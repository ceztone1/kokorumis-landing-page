  <div
    class="m-4 grid w-full animate-[appear_0.6s_ease-out_forwards] grid-cols-2 grid-rows-[30vh_30vh_30vh] gap-4 rounded-2xl bg-white/30 p-4 sm:grid-cols-3"
  >
    <div
      class="relative col-span-2 col-start-1 row-span-1 row-start-1 flex items-center justify-center sm:col-span-1 sm:col-start-2"
    >
      <p
        class="appear flex flex-col items-center justify-center gap-4 text-fontColor"
      >
        <span class="font-Chewy text-5xl text-fontColor md:text-8xl"
          >Make it posible!</span
        >
        <span class="font-Chewy text-4xl text-fontColor">Crafts & crochet</span>
      </p>
    </div>
    <div class="relative row-span-2 flex items-start">
      <Image
        class="reveal h-full w-full rounded-2xl object-cover"
        src={logo}
        alt="A description of my image."
      />
    </div>
    <div class="relative row-span-1 row-start-[-1] flex sm:row-span-2">
      <Image
        class="reveal h-full w-full rounded-2xl object-cover"
        src={melody}
        alt="A description of my image."
      />
    </div>
    <div class="relative row-span-2 flex">
      <Image
        class="reveal h-full w-full rounded-2xl object-cover"
        src={calciferImage}
        alt="A description of my image."
      />
    </div>
    <div class="relative row-span-2 flex sm:row-span-1">
      <Image
        class="reveal h-full w-full rounded-2xl object-cover"
        src={flower1}
        alt="A description of my image."
      />
    </div>
    <div
      class="relative col-start-2 row-span-1 row-start-2 flex sm:col-start-3 sm:row-start-3"
    >
      <Image
        class="reveal h-full w-full rounded-2xl object-cover"
        src={flower2}
        alt="A description of my image."
      />
    </div>

    <div class="relativeflex">
      <Image
        class="reveal h-full w-full rounded-2xl object-cover"
        src={flower2}
        alt="A description of my image."
      />
    </div>
    <div class="relativeflex">
      <Image
        class="reveal h-full w-full rounded-2xl object-cover"
        src={flower2}
        alt="A description of my image."
      />
    </div>
    <div class="relative flex">
      <Image
        class="reveal h-full w-full rounded-2xl object-cover"
        src={flower2}
        alt="A description of my image."
      />
    </div>
  </div>

  <style>
    .star-movement {
      animation:
        appear 1s,
        star-movement 2s infinite;
    }
    @keyframes star-movement {
      0% {
        -webkit-transform: rotate(0);
        transform: rotate(0);
        -webkit-animation-timing-function: ease-in;
        animation-timing-function: ease-in;
      }

      55% {
        -webkit-transform: rotate(0.1turn);
        transform: rotate(0.1turn);
        -webkit-animation-timing-function: ease-in;
        animation-timing-function: ease-in;
      }

      100% {
        -webkit-transform: rotate(0);
        transform: rotate(0);
        -webkit-animation-timing-function: ease-in;
        animation-timing-function: ease-in;
      }
    }
    .appear {
      animation-name: appear;
      animation-duration: 1s;
    }
    @keyframes appear {
      0% {
        opacity: 0;
        -webkit-transform: translateY(-10px);
        transform: translateY(-10px);
      }
      100% {
        opacity: 1;
        -webkit-transform: translateY(0);
        transform: translateY(0);
      }
    }
    @keyframes show {
      from {
        opacity: 0;
        scale: 90%;
      }
      to {
        opacity: 1;
        scale: 100%;
      }
    }
    .reveal {
      view-timeline-name: --reveal;
      animation-name: show;
      animation-fill-mode: both;

      animation-timeline: --reveal;
      animation-range: entry 25% cover 50%;
    }
  </style>
</section>
